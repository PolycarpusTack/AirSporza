# E2E build profile: FLAG-FM-ON (fm-e2e v1 — FM1-7-T0).
# Consumed by `vite build --mode e2e-fm-on`. TD-27: both VITE_OPS_REDESIGN and
# VITE_FM_SHELL are build-time only, so this combination needs its own build —
# BOTH flags true (FM1-7 AC): the FM interim bridge (ADR-014) navigates to real
# /ops/* routes, so a real /ops/schedule must exist for it to land on.
# VITE_API_URL=/api makes API calls SAME-ORIGIN so Playwright route interception
# needs no CORS handling (the real backend is never contacted in e2e).
# NOTE: values here must OVERRIDE the developer's local .env (loaded in all modes).
VITE_OPS_REDESIGN=true
VITE_FM_SHELL=true
VITE_API_URL=/api
